# ============================================================
# NEXORA FOREX FRONTEND — Variáveis de ambiente
#
# Copiar para .env.local e preencher os valores reais.
# No Render, configurar em Settings → Environment Variables.
#
# ATENÇÃO: em Vite, variáveis para o browser devem começar com
# VITE_ (equivalente ao NEXT_PUBLIC_ do Next.js).
# ============================================================

# URL do backend (sem barra final)
VITE_API_URL=https://banckend-nexora.onrender.com

# URL da WebSocket — se vazia, é derivada automaticamente do
# VITE_API_URL (troca https por wss). Só definir se o path for
# diferente do padrão raiz (/).
# VITE_WS_URL=wss://banckend-nexora.onrender.com

# Deriv App ID
VITE_DERIV_APP_ID=3356rGdzrsnQaEKsg8MMA
